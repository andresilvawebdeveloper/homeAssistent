# Copia este ficheiro para .env e coloca a tua chave da API da Anthropic
# (obtém uma em https://platform.claude.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Porta do servidor
PORT=3000

# Cidade para a meteorologia (latitude/longitude) — por defeito Lisboa
WEATHER_LAT=38.72
WEATHER_LON=-9.14
WEATHER_CITY=Lisboa
